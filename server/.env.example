# Server Port (Render sets this dynamically via process.env.PORT)
PORT=4000

# Environment mode: development | production | test
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Local Example: mongodb://127.0.0.1:27017/spotly
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/spotly?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/spotly

# Allowed CORS Origins (comma-separated). Set to your deployed Vercel frontend in production
# Example: https://spotly-client.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
